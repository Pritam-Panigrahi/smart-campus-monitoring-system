# Application
APP_NAME=Smart Campus Monitoring System
APP_ENV=development

# Comma-separated origins allowed to call the API from a browser. Docker
# Compose serves the frontend at http://localhost:8080.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Relative SQLite paths are resolved from the project root.
DATABASE_URL=sqlite:///smart_campus.db

# Uvicorn listens on this port. Docker Compose keeps the backend internal on
# port 8000 and exposes the frontend at http://localhost:8080.
PORT=8000

# Simulation begins only when POST /api/simulation/start is called.
SIMULATION_DEFAULT_MODE=DEMO
